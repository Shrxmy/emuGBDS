{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-release",
      "displayName": "MSVC Release (In-House Core)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EMUGBDS_ENABLE_MELONDS": "OFF"
      }
    },
    {
      "name": "nds-clang-release",
      "displayName": "Clang Release (NDS Third-Party Core)",
      "generator": "Visual Studio 17 2022",
      "toolset": "ClangCL",
      "binaryDir": "${sourceDir}/build-clang-vs",
      "cacheVariables": {
        "EMUGBDS_ENABLE_MELONDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-msvc-release",
      "configurePreset": "msvc-release",
      "configuration": "Release",
      "targets": [
        "emugbds"
      ]
    },
    {
      "name": "build-nds-clang-release",
      "configurePreset": "nds-clang-release",
      "configuration": "Release",
      "targets": [
        "emugbds"
      ]
    }
  ]
}
